{
    "name": "prisma-custom-relay-pagination",
    "version": "4.0.0",
    "description": "This package merges cursor, offset and relay pagination",
    "type": "module",
    "main": "./lib/index.js",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "default": "./lib/index.js"
        },
        "./lib/prisma": {
            "types": "./lib/prisma/index.d.ts",
            "import": "./lib/prisma/index.js",
            "default": "./lib/prisma/index.js"
        },
        "./lib/prisma/prisma-relay": {
            "types": "./lib/prisma/prisma-relay.d.ts",
            "import": "./lib/prisma/prisma-relay.js",
            "default": "./lib/prisma/prisma-relay.js"
        },
        "./lib/nestjs/decorators": {
            "types": "./lib/nestjs/decorators/index.d.ts",
            "import": "./lib/nestjs/decorators/index.js",
            "default": "./lib/nestjs/decorators/index.js"
        },
        "./lib/nestjs/decorators/resolver-select": {
            "types": "./lib/nestjs/decorators/resolver-select.d.ts",
            "import": "./lib/nestjs/decorators/resolver-select.js",
            "default": "./lib/nestjs/decorators/resolver-select.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --passWithNoTests",
        "build": "rimraf lib && tsc",
        "prepublish": "npm run build",
        "format": "prettier --write \"src/**/*.ts\"",
        "lint": "eslint \"src/**/*.ts\""
    },
    "keywords": [
        "graphql",
        "nestjs",
        "prisma",
        "pagination",
        "relay",
        "offset",
        "cursor",
        "decorator"
    ],
    "files": [
        "lib/**/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/MiltonMejia/prisma-relay-pagination.git"
    },
    "author": "mefam",
    "license": "MIT",
    "dependencies": {
        "lodash": "^4.17.21"
    },
    "peerDependencies": {
        "@nestjs/common": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/graphql": "^14.0.0",
        "@paljs/plugins": "^9.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0 || ^0.15.0",
        "graphql": "^16.11.0 || ^17.0.0",
        "reflect-metadata": "^0.1.13 || ^0.2.0"
    },
    "peerDependenciesMeta": {
        "@paljs/plugins": {
            "optional": true
        }
    },
    "devDependencies": {
        "@nestjs/common": "^12.0.3",
        "@nestjs/core": "^12.0.3",
        "@nestjs/graphql": "^14.0.1",
        "@paljs/plugins": "^9.0.0",
        "@prisma/client": "^7.10.0",
        "@types/jest": "^29.5.14",
        "@types/lodash": "^4.17.16",
        "@types/node": "^22.13.10",
        "@types/ws": "^8.18.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "eslint": "^9.22.0",
        "graphql": "^16.11.0",
        "jest": "^29.7.0",
        "prettier": "3.5.3",
        "prisma": "^7.10.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.2",
        "ts-jest": "^29.2.5",
        "ts-morph": "^25.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    }
}
